# ── FRONTEND ENV (local dev) ───────────────────────────────────────────────────
# Routes API calls through Next.js proxy (/api/proxy/*) → backend
# This avoids CORS issues and works even if backend is on a different port/host
NEXT_PUBLIC_API_URL=/api/proxy

# Where the backend runs — used server-side by the proxy route
# Local dev: http://localhost:5000
# Production: https://your-backend.onrender.com
BACKEND_URL=http://localhost:5000

# Razorpay public key (optional — only needed for online payments)
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx

# WhatsApp number with country code, no + sign
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# UPI ID for payment
NEXT_PUBLIC_UPI_ID=lonazluxe@upi

# Salon display name
NEXT_PUBLIC_SALON_NAME=Lonaz Luxe Salon
